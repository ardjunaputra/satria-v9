# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://satria_user:satria_password@localhost:5432/satria_db
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars_change_this

# API Keys
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
ALIENVAULT_API_KEY=your_alienvault_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@army.mil.my
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=SATRIA Intelligence <noreply@army.mil.my>

# Rate Limiting
RATE_LIMIT_WINDOW=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# Aggregation
AGGREGATION_INTERVAL=30
DATA_RETENTION_DAYS=90
